
APP_ENV=staging
PROJECT_SLUG=go-fiber-core
APP_NAME="${PROJECT_SLUG}"
DEVELOPER=

# Salida de logs de la aplicación: file | stdout | both
LOG_OUTPUT=both

SERVER_PORT=9009

#########################################################
### JWT Settings
JWT_ACCESS_SECRET="tu_super_secreto_para_access_tokens"
JWT_REFRESH_SECRET="tu_otro_super_secreto_para_refresh_tokens"
JWT_ACCESS_TTL_MINUTES=15m
JWT_REFRESH_TTL_DAYS=2160h
#########################################################

#########################################################
### REDIS (AWS ElastiCache Endpoint)
REDIS_HOST=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_EXPIRES_IN_SECONDS=230
POOL_SIZE=50
#########################################################

#########################################################
# GORM DATABASE CONNECTIONS WRITE => (PRIMARY RDS)
#########################################################
GORM_WRITE_DRIVER=postgres
GORM_WRITE_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
GORM_WRITE_PORT=5432
GORM_WRITE_USER=postgres
GORM_WRITE_PASSWORD=postgres
GORM_WRITE_DBNAME=go_fiber_core
GORM_WRITE_SCHEMA=public
GORM_WRITE_MAX_OPEN_CONNS=15
GORM_WRITE_MAX_IDLE_CONNS=10
GORM_WRITE_CONN_MAX_LIFETIME_SECONDS=300

#########################################################
# GORM DATABASE CONNECTIONS READ => (REPLICA RDS)
#########################################################
GORM_READ_DRIVER=postgres
GORM_READ_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
GORM_READ_PORT=5432
GORM_READ_USER=postgres
GORM_READ_PASSWORD=postgres
GORM_READ_DBNAME=go_fiber_core
GORM_READ_SCHEMA=public
GORM_READ_MAX_OPEN_CONNS=15
GORM_READ_MAX_IDLE_CONNS=10
GORM_READ_CONN_MAX_LIFETIME_SECONDS=300

#########################################################
# PGX DATABASE CONNECTIONS WRITE => (PRIMARY RDS)
#########################################################
PGX_WRITE_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
PGX_WRITE_PORT=5432
PGX_WRITE_USER=postgres
PGX_WRITE_PASSWORD=postgres
PGX_WRITE_DBNAME=go_fiber_core
PGX_WRITE_MAX_CONNS=15

#########################################################
# PGX DATABASE CONNECTIONS READ => (REPLICA RDS)
#########################################################
PGX_READ_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
PGX_READ_PORT=5432
PGX_READ_USER=postgres
PGX_READ_PASSWORD=postgres
PGX_READ_DBNAME=go_fiber_core
PGX_READ_MAX_CONNS=15

#########################################################
# DATABASE DRIVER
#########################################################
DB_ACTIVE_DRIVER=postgres
#########################################################

#########################################################
### DB Logs / Slow SQL
#########################################################
DB_LOG_LEVEL=warn
DB_SLOW_THRESHOLD_MS=500
