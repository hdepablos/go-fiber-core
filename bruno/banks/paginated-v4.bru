meta {
  name: paginated-v4
  type: http
  seq: 10
}

post {
  url: {{urlBase}}api/v1/banks/paginated
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "sortBy": ["banks.created_at"],
      "sortDesc": [false],
      "filterBy": ["banks.created_at"],
      "filterValues": [["2025-12-01","2025-12-03"]],
      "rowsPerPage": 15,
      "page": 1
  }
}
