meta {
  name: preview - all
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/batch-preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "process_type_id": 19,
    "sede_id": 0,
    "override_process_version_id": 22,
    "roadmap": 0,
    "mode": "all",
    "limit": 10,
    "offset": 0,
    "apply_changes": false,
    "input": {
      "id": 2,
      "key_redis": "{{redis_key_export_preview}}"
    }
  }
}
