meta {
  name: run - row_numbers
  type: http
  seq: 8
}

vars {
  process_type_id_batch_current: 19
  process_version_id_batch_current: 22
  sede_id_batch_current: 0
  bulk_job_id_batch_current: 1
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/run
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:json {
  {
    "process_type_id": {{process_type_id_batch_current}},
    "sede_id": {{sede_id_batch_current}},
    "override_process_version_id": {{process_version_id_batch_current}},
    "roadmap": 0,
    "input": {
      "id": {{bulk_job_id_batch_current}},
      "filters": {
        "status_code": "IMPORTED",
        "row_number": [2, 3, 4, 5, 6]
      }
    }
  }
}
