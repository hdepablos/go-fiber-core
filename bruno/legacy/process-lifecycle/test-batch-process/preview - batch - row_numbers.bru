meta {
  name: preview - batch - row_numbers
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/batch-preview
  body: json
  auth: bearer
}

headers {
  X-Client-Code: bruno
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "process_type_id": 19,
    "sede_id": 0,
    "override_process_version_id": 22,
    "roadmap": 0,
    "mode": "batch",
    "limit": 1,
    "row_numbers": [1],
    "input": {
      "id": 1,
      "key_redis": "{{redis_key_export_preview}}"
    }
  }
}
