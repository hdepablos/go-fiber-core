meta {
  name: preview - batch - batch_index
  type: http
  seq: 3
}

vars {
  process_type_id_batch_current: 19
  process_version_id_batch_current: 22
  sede_id_batch_current: 0
  bulk_job_id_batch_current: 1
  redis_key_batch_current: preview-punitorios-root
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/batch-preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:json {
  {
    "process_type_id": {{process_type_id_batch_current}},
    "sede_id": {{sede_id_batch_current}},
    "override_process_version_id": {{process_version_id_batch_current}},
    "roadmap": 0,
    "mode": "batch",
    "batch_index": 0,
    "limit": 10,
    "input": {
      "id": {{bulk_job_id_batch_current}},
      "key_redis": "{{redis_key_batch_current}}"
    }
  }
}
