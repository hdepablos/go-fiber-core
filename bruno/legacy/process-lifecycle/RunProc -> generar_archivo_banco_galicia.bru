meta {
  name: RunProc -> generar archivo banco galicia (process_type_id = 17)
  type: http
}

vars {
  process_type_id_generar_archivo_banco_galicia: 17
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/run
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "process_type_id": {{process_type_id_generar_archivo_banco_galicia}},
    "sede_id": 0,
    "override_process_version_id": 0,
    "roadmap": 0,
    "input": {
      "id": 2,
      "filters": {
        "bulk_job_items.status_code": "ERROR_PROCESS"
      }
    }
  }
}
