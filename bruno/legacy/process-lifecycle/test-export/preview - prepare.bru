meta {
  name: preview - prepare
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/export-preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "process_type_id": 14,
    "sede_id": 0,
    "override_process_version_id": 0,
    "roadmap": 0,
    "mode": "prepare",
    "input": {
      "id": 2,
      "key_redis": "{{redis_key_export_preview}}",
      "filters": [
        {
          "field": "status_code",
          "operator": "eq",
          "value": "ERROR_PROCESS"
        }
      ]
    }
  }
}
