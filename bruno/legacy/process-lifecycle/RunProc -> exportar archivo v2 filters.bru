  token: {{access_token}}
}

body:json {
  {
    "process_type_id": 13,
    "sede_id": 0,
    "override_process_version_id": 20,
    "roadmap": 0,
    "input": {
      "id": 2,
      "filters": {
        "bulk_job_items.status_code": "ERROR_PROCESS"
      }
    }
  }
}
