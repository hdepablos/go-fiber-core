meta {
  name: login - valid
  type: http
  seq: 2
}

post {
  url: {{urlBase}}api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-Client-Code: 12345678
}

body:json {
  {
    "email": "hdepablos@libgot.com",
    "password": "123456"
  }
}

script:post-response {
  let responseBody = res.getBody();
  
  if (typeof responseBody === "string") {
    responseBody = JSON.parse(responseBody);
  }
  
  const token = responseBody?.data?.access_token || responseBody?.data?.token;
  if (token) {
    bru.setVar('access_token', token);
    bru.setVar('auth_error', '');
  } else {
    bru.setVar('access_token', '');
    bru.setVar('auth_error', responseBody?.message || 'login failed');
  }
}
