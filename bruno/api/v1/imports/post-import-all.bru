meta {
  name: post-import-create
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/imports/
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:multipart-form {
  branch_id: {{branch_id}}
  ref_code: {{import_ref_code}}
  total: {{import_total}}
  key_code: {{import_key}}
  file: @file({{import_file_path}})
}
