meta {
  name: post-promote
  type: http
  seq: 2
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/promote
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:json {
{
  "process_version_id": {{process_version_id}},
  "comment": "Promocion a PROD desde Bruno",
  "promoted_by": {{user_id}}
}
}
