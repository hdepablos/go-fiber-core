meta {
  name: post-replicate
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/replicate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:json {
{
  "process_version_id": {{process_version_id}},
  "operator_id": {{user_id}}
}
}
