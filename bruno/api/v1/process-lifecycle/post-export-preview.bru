meta {
  name: post-export-preview
  type: http
  seq: 9
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/export-preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  X-Client-Code: bruno
}

body:json {
{
  "process_type_id": {{process_type_id_export_preview}},
  "sede_id": 0,
  "override_process_version_id": 0,
  "roadmap": 0,
  "mode": "prepare",
  "batch_size": 100,
  "limit": 20,
  "offset": 0,
  "item_ids": [1, 2],
  "row_numbers": [10, 20],
  "input": {
    "id": {{bulk_job_id_export_preview}},
    "key_redis": "{{redis_key_export_preview}}",
    "filters": [
      {
        "field": "status_code",
        "operator": "eq",
        "value": "ERROR_PROCESS"
      }
    ]
  }
}
}
