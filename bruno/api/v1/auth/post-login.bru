meta {
  name: post-login
  type: http
  seq: 1
}

post {
  url: {{urlBase}}api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-Client-Code: bruno
}

body:json {
{
  "email": "admin@example.com",
  "password": "12345678"
}
}

script:post-response {
let responseBody = res.getBody();
if (typeof responseBody === "string") {
  responseBody = JSON.parse(responseBody);
}
const accessToken = responseBody?.data?.access_token || responseBody?.data?.token;
const refreshToken = responseBody?.data?.refresh_token;
if (accessToken) {
  bru.setVar("access_token", accessToken);
}
if (refreshToken) {
  bru.setVar("refresh_token", refreshToken);
}
}
