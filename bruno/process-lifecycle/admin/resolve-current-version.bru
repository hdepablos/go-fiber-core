meta {
  name: resolve current version
  type: http
  seq: 5
}

post {
  url: {{urlBase}}api/v1/process-lifecycle/current-version
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "process_type_id": 1,
    "sede_id": 1,
    "override_process_version_id": null
  }
}
