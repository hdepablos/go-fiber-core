package catalog

import (
	"context"
	"encoding/json"
	"os"
	"strconv"
	"time"

	"go-fiber-core/internal/logger"
	"go-fiber-core/internal/models"

	redis "github.com/redis/go-redis/v9"
	"go.uber.org/zap"
	"golang.org/x/sync/errgroup"
	"gorm.io/gorm"
)

type CatalogRepository interface {
	GetAll(ctx context.Context, db *gorm.DB) (models.AllCatalogsResponse, error)
	InvalidateCache(ctx context.Context) error
}

type catalogRepository struct {
	redis      *redis.Client
	cacheKey   string
	expiration time.Duration
}

func NewCatalogRepository(redisClient *redis.Client) CatalogRepository {
	projectPrefix := os.Getenv("APP_NAME")
	if projectPrefix == "" {
		projectPrefix = "go-fiber-core"
	}

	return &catalogRepository{
		redis:      redisClient,
		cacheKey:   projectPrefix + ":catalogs:all",
		expiration: 24 * time.Hour, // TTL largo porque invalidaremos manualmente
	}
}

func (r *catalogRepository) GetAll(ctx context.Context, db *gorm.DB) (models.AllCatalogsResponse, error) {
	var response models.AllCatalogsResponse

	log := logger.GetLogger("catalogs-cache")

	if r.redis != nil {
		log.Info("catalogs: intentando leer cache Redis", zap.String("key", r.cacheKey))
		redisCtx, cancel := context.WithTimeout(ctx, 200*time.Millisecond)
		cachedBytes, err := r.redis.Get(redisCtx, r.cacheKey).Bytes()
		cancel()
		if err == nil && len(cachedBytes) > 0 {
			if err := json.Unmarshal(cachedBytes, &response); err == nil {
				log.Info("catalogs: cache hit", zap.String("key", r.cacheKey), zap.Int("bytes", len(cachedBytes)))
				return response, nil
			}
			log.Error("catalogs: error al deserializar cache", zap.String("key", r.cacheKey), zap.Error(err))
		} else {
			if err != nil {
				log.Info("catalogs: cache miss o error en GET", zap.String("key", r.cacheKey), zap.Error(err))
			} else {
				log.Info("catalogs: cache vacio", zap.String("key", r.cacheKey))
			}
		}
	} else {
		log.Info("catalogs: redis client es nil, se salta cache")
	}

	g, ctx := errgroup.WithContext(ctx)

	g.Go(func() error {
		log.Info("catalogs: consultando bancos en DB")
		return db.WithContext(ctx).Table("banks").
			Select("id, name, enabled as is_active").
			Where("deleted_at IS NULL").Scan(&response.Banks).Error
	})

	g.Go(func() error {
		return db.WithContext(ctx).Table("roles").
			Select("id, name, is_active").
			Where("deleted_at IS NULL").Scan(&response.Roles).Error
	})
	g.Go(func() error {
		return db.WithContext(ctx).Table("users").
			Select("id, name, is_active").
			Where("deleted_at IS NULL").Scan(&response.Users).Error
	})
	g.Go(func() error {
		return db.WithContext(ctx).Table("menus").
			Select("id, item_name as name, is_active").
			Where("deleted_at IS NULL").Scan(&response.Menus).Error
	})

	if err := g.Wait(); err != nil {
		log.Error("catalogs: error consultando DB", zap.Error(err))
		return models.AllCatalogsResponse{}, err
	}

	log.Info(
		"catalogs: DB OK",
		zap.Int("banks", len(response.Banks)),
		zap.Int("roles", len(response.Roles)),
		zap.Int("users", len(response.Users)),
		zap.Int("menus", len(response.Menus)),
	)

	if r.redis != nil {
		if data, err := json.Marshal(response); err == nil {
			timeout := 1 * time.Second
			if v := os.Getenv("CATALOGS_CACHE_SET_TIMEOUT_MS"); v != "" {
				if ms, err := strconv.Atoi(v); err == nil && ms > 0 {
					timeout = time.Duration(ms) * time.Millisecond
				}
			}
			log.Info(
				"catalogs: escribiendo cache Redis",
				zap.String("key", r.cacheKey),
				zap.Duration("timeout", timeout),
				zap.Int("bytes", len(data)),
			)
			redisCtx, cancel := context.WithTimeout(context.Background(), timeout)
			errSet := r.redis.Set(redisCtx, r.cacheKey, data, r.expiration).Err()
			cancel()
			if errSet != nil {
				log.Error("catalogs: error al escribir cache Redis", zap.String("key", r.cacheKey), zap.Error(errSet))
			} else {
				log.Info("catalogs: cache Redis escrito correctamente", zap.String("key", r.cacheKey))
			}
		} else {
			log.Error("catalogs: error serializando respuesta para cache", zap.Error(err))
		}
	}

	return response, nil
}

func (r *catalogRepository) InvalidateCache(ctx context.Context) error {
	return r.redis.Del(ctx, r.cacheKey).Err()
}
